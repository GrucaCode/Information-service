<div id="pop-up" class="pop-up js-pop-up" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="pop-up__backdrop" data-close></div>
  <div class="pop-up__dialog js-pop-up-dialog" role="document" tabindex="-1">
    <div class="close-btn-wrapper">
      <p class="close-btn-text">Zamknij</p>
      <button class="close-btn js-close-pop-up-btn">
        <div class="close-btn__frame">
          <i class="material-icons-outlined close-btn__icon">close</i>
        </div>
      </button>
    </div>
    <div class="pop-up__title-wrapper">
      <i class="material-icons-outlined pop-up__icon">warning</i>
      <h2 class="pop-up__title js-pop-up-title"></h2>
    </div>
    <p class="pop-up__desc js-pop-up-desc"></p>
    <button type="button" class="font-adj-btn js-font-adj-btn">
      <i class="material-icons-outlined js-icon-a-plus">text_increase</i>
      <p class="font-adj-btn__text">Dostosuj czcionkę</p>
    </button>
  </div>
</div>