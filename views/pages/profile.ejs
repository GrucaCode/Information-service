<!DOCTYPE html>
<html lang="pl">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Info Stacja - Twój profil</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.6/dist/driver.css">
  <script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.6/dist/driver.js.iife.js"></script>
  <link rel="stylesheet" href="css/profile-page.css" />
</head>

<body>
  <%- include('../partials/hamburgerMenu') %>
  <header>
    <%- include('../partials/topNavBar')  %>
    <div class="hero">
      <h1>Twój profil</h1>
      <p class="hero__text">W profilu możesz zobaczyć swoje dane oraz zapisywać i usuwać wiadomości</p>
    </div>
  </header>
  <main>
    <%- include('../partials/loader')  %>

    <section id="login-section" class="login-sec is-hidden">
      <div class="login-sec__title">
        <i class="material-icons-outlined arrow-right">arrow_right</i>
        <h2 class="login-sec__h">Logowanie</h2>
      </div>
      <div class="data-reg-success-message success-message" hidden></div>
      <div class="login-sec__wrapper">
        <p class="login-sec__quest--up login-sec__quest">Masz już założony profil użytkownika na Info Stracji?</p>
        <form id="login-form" class="login-form">
          <label for="login-email" class="login-form__label">Adres e-mail:</label>
          <input type="email" id="login-email" name="email" placeholder="Wpisz e-mail" required class="login-form__input data-register-input" autocomplete="email" />
          <label for="login-password" class="login-form__label">Hasło:</label>
          <input type="password" name="password" placeholder="Wpisz hasło" required class="login-form__input data-register-input" id="login-password" autocomplete="current-password" />
          <div class="see-pass-btn-wrapper">
            <p class="see-pass-text data-see-pass-text">Zobacz hasło</p>
            <button type="button" class="see-pass-btn">
              <div class="see-pass-btn__frame">
                <i class="material-icons-outlined see-pass-btn__visibility data-see-pass-icon">visibility</i>
              </div>
            </button>
          </div>
          <div id="login-message" class="login-form__message"></div>
          <button type="submit" class="login-submit-btn data-login-submit-btn">
            <div class="login-submit-btn__frame data-submit-frame">
              <p class="login-submit-btn__text">Zaloguj się</p>
            </div>
          </button>
        </form>
        <p class="login-sec__quest--down login-sec__quest">Nie masz założonego profilu?</p>
        <button id="show-register" class="show-register-btn">
          <i class="material-icons-outlined show-register-arrow">arrow_right</i>
          <p class="show-register-btn__text">Załóż profil tutaj</p>
        </button>
      </div>
    </section>
    <section id="register-section" class="register-sec is-hidden">
      <div class="register-sec__title">
        <i class="material-icons-outlined arrow-right">arrow_right</i>
        <h2 class="register-sec__h">Rejestracja</h2>
      </div>
      <div class="register-sec__avatar">
        <img src="img/register-awatar.svg" alt="Osoba na zielonym tle" class="register-sec__img">
        <p class="freepik-info">Designed by
          <a href="https://pl.freepik.com/" target="_blank" rel="noopener noreferrer" class="freepik-info__link">Freepik
          </a>
        </p>
      </div>
      <div class="register-sec__wrapper">
        <p class="register-sec__quest--up register-sec__quest">Nie masz jeszcze założonego profilu na Info
          Stacji?</p>
        <div class="clean-btn-wrapper">
          <p class="clean-text data-clean-text">Wyczyść formularz</p>
          <button type="button" class="clean-btn">
            <div class="clean-btn__frame">
              <i class="material-icons-outlined clean-btn__visibility" id="brush-icon">cleaning_services</i>
            </div>
          </button>
        </div>
        <form id="register-form" class="register-form data-register-form">
          <label for="firstName" class="register-form__label">Imię:</label>
          <input type="text" id="firstName" name="firstName" placeholder="Wpisz imię" required autocomplete="given-name" class="register-form__input data-register-input" />
          <label for="lastName" class="register-form__label">Nazwisko:</label>
          <input type="text" id="lastName" name="lastName" placeholder="Wpisz nazwisko" required autocomplete="family-name" class="register-form__input data-register-input" />
          <div class="register-form__labels">
            <label for="email" class="register-form__label">E-mail:</label>
            <p class="register-form__label-additional">imię@example.com</p>
          </div>
          <input type="email" id="email" name="email" placeholder="Wpisz e-mail" required autocomplete="email" class="register-form__input data-register-input" />
          <label for="password" class="register-form__label">Hasło:</label>
          <input type="password" id="password" name="password" placeholder="Wpisz hasło" required class="register-form__input data-register-input" />
          <div class="see-pass-btn-wrapper">
            <p class="see-pass-text data-see-pass-text">Zobacz hasło</p>
            <button type="button" class="see-pass-btn register-see-pass-btn">
              <div class="see-pass-btn__frame">
                <i class="material-icons-outlined see-pass-btn__visibility data-see-pass-icon">visibility</i>
              </div>
            </button>
          </div>
          <div id="register-message" class="register-form__message data-register-message"></div>
          <button type="submit" class="register-submit-btn data-register-submit-btn">
            <div class="register-submit-btn__frame data-submit-frame">
              <p class="register-submit-btn__text">Zarejestruj się</p>
            </div>
          </button>
        </form>
      </div>
      <p class="register-sec__quest--down register-sec__quest">Masz już założony profil?</p>
      <button id="show-login" class="show-login-btn">
        <i class="material-icons-outlined show-login-arrow">arrow_right</i>
        <p class="show-login-btn__text">Zaloguj się tutaj</p>
      </button>
    </section>
    <section id="user-section" class="user-sec is-hidden">
      <div class="logout-btn-wrapper">
        <p class="logout-btn-text">Wyloguj się</p>
        <button class="logout-btn data-logout-btn">
          <div class="logout-btn__frame">
            <i class="material-icons-outlined logout-btn__exit">exit_to_app</i>
          </div>
        </button>
      </div>
      <div class="data-sec">
        <div class="data-sec__title">
          <i class="material-icons-outlined arrow-right">arrow_right</i>
          <h2 class="data-sec__h">Twoje dane</h2>
        </div>
        <div class="data-sec__wrapper data-data-sec">
          <div class="user-data__content">
            <div class="user-data__img-info1">
              <div class="user-data__avatar">
                <img src="img/awatar.svg" alt="Awatar użytkownika">
                <p class="freepik-info">Designed by
                  <a href="https://pl.freepik.com/" target="_blank" rel="noopener noreferrer" class="freepik-info__link">Freepik</a>
                </p>
              </div>
              <div class="user-data__info1">
                <div class="user-data__item">
                  <p class="user-data__text user-data__label">Imię:</p>
                  <p class="user-data__text user-data__value" id="user-firstName"></p>
                </div>
                <div class="user-data__item">
                  <p class="user-data__text user-data__label">Nazwisko:</p>
                  <p class="user-data__text user-data__value" id="user-lastName"></p>
                </div>
              </div>
            </div>
            <div class="user-data__info2">
              <div class="user-data__item user-data__item--email">
                <p class="user-data__text user-data__text--email user-data__label">E-mail:</p>
                <p class="user-data__text user-data__value user-data__value--email" id="user-email">
                  kowalska@example.pl
                </p>
              </div>
            </div>
          </div>
        </div>
        <button class="profile-drop-up-btn data-drop-up">
          <p class="profile-drop-up-btn__text data-drop-up-text">zwiń sekcje</p>
          <i class="material-icons-outlined profile-drop-up-btn__arrow data-drop-up-icon">arrow_drop_up</i>
        </button>
      </div>

      <div class="saved-sec">
        <div class="saved-sec">
          <div class="saved-sec__title">
            <i class="material-icons-outlined arrow-right">arrow_right</i>
            <h2 class="saved-sec__h">Zapisane wiadomości</h2>
          </div>

          <form id="sort-form" class="sort-form">
            <label for="sort" class="sort-form__label">Sortuj:</label>
            <select id="sort" name="sort" class="sort-form__select">
              <option value="newest" class="sort-form__option">od najnowszych</option>
              <option value="oldest" class="sort-form__option">od najstarszych</option>
            </select>
          </form>

          <div id="saved-list"></div>
        </div>
    </section>
  </main>
  <%- include('../partials/footer') %>
  <div class="space"></div>
  <%- include('../partials/bottomNavBar') %>
  <%- include('../partials/goUpBtn') %>
  <%- include('../partials/tutorialPopUp') %>
  <%- include('../partials/universalPopUp') %>

  <script type="module" src="js/utils.js"></script>
  <script type="module" src="js/profile.js"></script>
  <script type="module" src="js/auth.js"></script>
  <script type="module" src="js/fontAdjust.js"></script>
  <script type="module" src="js/upButton.js"></script>
  <script type="module" src="js/hamburgerMenu.js"></script>
  <script type="module" src="js/hideSection.js"></script>
  <script type="module" src="js/cleanRegistration.js"></script>
  <script type="module" src="js/tutorialPopUp.js"></script>
  <script type="module" src="js/voiceTutorial.js"></script>
</body>

</html>